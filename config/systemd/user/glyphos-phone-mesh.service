[Unit]
Description=GlyphOS trusted phone discovery and KDE Connect storage bridge
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -u %h/.config/glyphos/scripts/phone_mesh.py --daemon
Restart=on-failure
RestartSec=3
TimeoutStopSec=3
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target

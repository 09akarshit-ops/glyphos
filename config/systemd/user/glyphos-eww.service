[Unit]
Description=GlyphOS single foreground Eww server
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/eww --no-daemonize --config %h/.config/eww daemon
Restart=on-failure
RestartSec=3
TimeoutStopSec=3
KillMode=control-group

[Install]
WantedBy=default.target

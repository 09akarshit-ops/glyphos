(defvar glyph-dark false)
(defvar glyph-assets "assets")
(defvar glyph-context "default")
(defvar glyph-title "GlyphOS")
(defvar glyph-address "")
(defvar glyph-focus false)
(defvar glyph-wifi-rows "[]")
(defvar glyph-bt-rows "[]")
(defvar glyph-notifications "[]")
(defvar glyph-detail "")
;; GlyphOS reference desktop: 1408 x 768; fractional anchors adapt to other displays.
(defwidget glyphos-brand []
  (box :class "glyphos-brand" :orientation "h" :space-evenly false :spacing 10
    (image :path "${glyph-assets}/glyphos-dark.svg" :image-width 30 :image-height 30)
    (label :class "launcher-title" :markup "<span font_family='Ndot 55'>GLYPHOS</span>" :halign "start")))
(defwidget circle-action [icon command]
  (button :class "circle-action dock-icon" :onclick command :tooltip {icon == "home" ? "Glyph App Store" : icon}
    :onrightclick "~/.config/eww/scripts/app-service.py context-icon ${icon}"
    (image :path {icon == "chat" ? "${glyph-assets}/whatsapp.svg" : icon == "home" ? "${glyph-assets}/glyphos.svg" : "${glyph-assets}/${icon}.svg"} :image-width 38 :image-height 38)))
(defwidget shortcut [icon title command]
  (box :orientation "v" :space-evenly false :spacing 7
    (button :class "desktop-app" :onclick command :halign "center" :tooltip title
      (image :path "${glyph-assets}/${icon}.svg" :image-width 40 :image-height 40))
    (label :class "desktop-app-label" :text title)))
(deflisten island-art :initial '{"a":"background-color:#000000;","b":"background-color:#000000;","pane":0,"art":""}' "python3 -u ~/.config/eww/scripts/island-art.py")
(deflisten island-state :initial '{"active": "GlyphOS", "next": "Live activities", "synced": false, "marquee": false, "lyrics_mode": "none", "lyrics_description": "Live activities", "current_lyric": "", "next_lyric": "", "playing": false, "player": "", "line": -1, "title": "Nothing Playing", "artist": "No Artist", "status": "Stopped", "progress": 0, "pane": 0, "reveal_a": true, "reveal_b": false, "a": {"active": "GlyphOS", "next": "Live activities"}, "b": {"active": "GlyphOS", "next": "Live activities"}, "lyric_animating": false, "lyric_old": "", "lyric_promoted": "", "lyric_following": "", "lyric_old_y": 0, "lyric_active_y": 0, "lyric_next_y": 24, "lyric_old_alpha": 0, "lyric_active_alpha": 1, "lyric_next_alpha": 0.4, "lyric_active_size": 18}'
  "python3 -u ~/.config/eww/scripts/island-lyrics-listen.py")
(defpoll bar-time :interval "1s" "date '+%I:%M:%S %p' | sed 's/^0//'")
(defpoll bar-date :interval "30s" "date '+%a %d %b' | tr '[:lower:]' '[:upper:]'")
(defpoll bar-power :interval "3s" :initial '{"capacity":"—","plugged":false,"status":"Unknown"}' "~/.config/eww/scripts/desktop-status.py power")
(defpoll bar-connectivity :interval "5s" :initial '{"wifi":false,"bluetooth":false}' "~/.config/eww/scripts/desktop-status.py connectivity")
;; The bar never takes keyboard focus; actions target explicit client addresses.
(defvar taskbar-windows "[]")
(defwidget taskbar []
  (scroll :hscroll true :vscroll false :hexpand true
    (box :class "taskbar" :space-evenly false :spacing 4
      (for window in taskbar-windows
        (button :class {window.style} :tooltip {window.tooltip}
          :onclick "~/.config/eww/scripts/taskbar.py click ${window.address}"
          :onrightclick "~/.config/eww/scripts/app-service.py context ${window.app_key} ${window.address}"
          (image :path {window.icon} :image-width 22 :image-height 22))))))
(defwidget island-pill-widget []
(eventbox :halign "center" :onclick "python3 ~/.config/eww/scripts/island-action.py"
      (box :class "island-pill" :width 400 :valign "center"
        (overlay :height 42
          (box :height 42 :width 400)
          (revealer :transition "crossfade" :duration "600ms" :reveal {island-art.pane == 0}
            (box :class "island-art-layer" :height 42 :width 400 :style {island-art.a}))
          (revealer :transition "crossfade" :duration "600ms" :reveal {island-art.pane == 1}
            (box :class "island-art-layer" :height 42 :width 400 :style {island-art.b}))
          (box :orientation "v" :space-evenly false :spacing 2 :valign "center" :visible {island-state.marquee}
            (label :class "island-active" :height 22 :text {island-state.active} :limit-width 40 :show-truncated true :tooltip {island-state.title})
            (label :class "island-next" :visible {island-state.lyrics_mode != "synced" && island-state.lyrics_mode != "plain"} :height 18 :text {island-state.next} :limit-width 40 :show-truncated true))
          (box :orientation "v" :space-evenly false :spacing 2 :valign "center" :visible {!island-state.marquee && !island-state.lyric_animating}
            (label :class "island-active" :height 22 :text {island-state.active} :limit-width 40 :show-truncated true :tooltip {island-state.lyrics_description})
            (label :class "island-next" :visible {island-state.lyrics_mode != "synced" && island-state.lyrics_mode != "plain"} :height 18 :text {island-state.next} :limit-width 40 :show-truncated true))
          (overlay :height 42 :visible {island-state.lyric_animating}
            (box :height 42 :width 368)
            (transform :translate-y "${island-state.lyric_old_y}px" :valign "center"
              (label :class "island-motion-line" :height 22 :text {island-state.lyric_old} :limit-width 40 :show-truncated true :style "font-size:18px; font-weight:600; color:rgba(255,255,255,${island-state.lyric_old_alpha});"))
            (transform :translate-y "${island-state.lyric_active_y}px" :valign "center"
              (label :class "island-motion-line" :height 22 :text {island-state.lyric_promoted} :limit-width 40 :show-truncated true :style "font-size:${island-state.lyric_active_size}px; font-weight:600; color:rgba(255,255,255,${island-state.lyric_active_alpha});")))))))
(defwindow fullscreen-island
 :namespace "glyphos-fullscreen-island"
 :monitor 0
 :geometry (geometry :x "0px" :y "6px" :width "402px" :height "48px" :anchor "top center")
 :stacking "overlay"
 :exclusive false
 :focusable false
 (island-pill-widget))
(defwindow top-bar
  :namespace "glyphos-top-bar"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "50px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (box :class "desktop-bar" :tooltip {modal-active ? "" : ""} :space-evenly true :spacing 0
    (box :space-evenly false :spacing 10 :hexpand true
      (label :text bar-time)
      (label :text bar-date)
      (taskbar))
    (island-pill-widget)
    (box :space-evenly false :spacing 10 :halign "end"
      (box :class "bar-status-pill" :space-evenly false :spacing 10 :valign "center"
      (button :class {bar-connectivity.bluetooth ? "bar-button radio-on" : "bar-button indicator-off"} :onclick "eww --no-daemonize open --toggle bluetooth-menu" :tooltip {bar-connectivity.bluetooth ? "Bluetooth on" : "Bluetooth off"}
        (image :path "${glyph-assets}/bluetooth-dark.svg" :image-width 22 :image-height 22))
      (button :class {bar-connectivity.wifi ? "bar-button radio-on" : "bar-button indicator-off"} :onclick "eww --no-daemonize open --toggle wifi-menu" :tooltip {bar-connectivity.wifi ? "Wi-Fi on" : "Wi-Fi off"}
        (image :path "${glyph-assets}/wifi-dark.svg" :image-width 26 :image-height 26))
      (button :class {bar-power.plugged ? "bar-battery-pill charging" : "bar-battery-pill"} :onclick "eww --no-daemonize open --toggle power-display"
        :tooltip {bar-power.plugged ? "Plugged in · ${bar-power.status}" : "Battery · ${bar-power.status}"}
        (box :space-evenly false :spacing 6
          (image :path {bar-power.plugged ? "${glyph-assets}/battery-charging-dark.svg" : "${glyph-assets}/battery-dark.svg"} :image-width 30 :image-height 24)
          (label :text {bar-power.capacity == "—" ? "AC" : "${bar-power.capacity}%"}))))
      (button :class "bar-profile" :valign "center" :onclick "eww --no-daemonize open --toggle control-center" :tooltip "Control center" "⌁"))))
(defwindow dot-field
  :namespace "glyphos-dot-field"
  :monitor 0
  :geometry (geometry :x "1%" :y "7%" :width "530px" :height "235px" :anchor "top right")
  :stacking "bottom"
  :focusable false
  (image :visible cc-glyph :path "${glyph-assets}/dot-field.svg" :image-width 530 :image-height 235))
(defvar settings-tab "Display")
(defpoll settings-display :interval "30s" :initial '{"scale":"100%","scales":["100%","125%","150%","175%","200%"],"mode":"","modes":[],"summary":"Detecting displays…"}' "~/.config/eww/scripts/settings-display.py state")
(defwindow home
  :namespace "glyphos-home"
  :monitor 0
  :geometry (geometry :x "0px" :y "41.5%" :width "952px" :height "102px" :anchor "top center")
  :stacking "bottom"
  :focusable false
  (box :class "desktop-shortcuts" :space-evenly true :spacing 0
    (shortcut :icon "glyphos" :title "App Store" :command "hyprctl dispatch exec /home/nothing_os/.local/bin/glyph-store")
    (shortcut :icon "browser" :title "Browser" :command "brave &")
    (shortcut :icon "files" :title "files" :command "~/.local/bin/glyphos-files &")
    (shortcut :icon "settings" :title "settings" :command "eww --no-daemonize open settings-window")
    (shortcut :icon "mail" :title "mail" :command "xdg-open https://mail.google.com &")
    (shortcut :icon "music" :title "music" :command "spotify &")
    (shortcut :icon "notes" :title "notes" :command "eww --no-daemonize open --toggle calendar-tasks")
    (shortcut :icon "photos" :title "Photos" :command "dolphin ~/Pictures &")))

(defwindow dock
  :namespace "glyphos-dock"
  :monitor 0
  :geometry (geometry :x "0px" :y "9px" :width "1px" :height "80px" :anchor "bottom center")
  :stacking "bottom"
  :focusable false
  (box :class "glass-dock" :space-evenly false :spacing 17
    (circle-action :icon "home" :command "hyprctl dispatch exec /home/nothing_os/.local/bin/glyph-store")
    (circle-action :icon "files" :command "~/.local/bin/glyphos-files &")
    (circle-action :icon "chat" :command "brave --app=https://web.whatsapp.com &")
    (circle-action :icon "ai" :command "~/.config/glyphos/scripts/launch-gemini.sh &")
    (circle-action :icon "browser" :command "brave &")
    (box :visible {glyph-context == "dev"} :space-evenly false :spacing 6
      (button :class "glyph-action" :onclick "~/.config/glyphos/scripts/actions.py git" :tooltip "Git status" "Git")
      (button :class "glyph-action" :onclick "~/.config/glyphos/scripts/actions.py terminal" :tooltip "Toggle terminal" ">_"))
))


(defpoll cc-state :interval "3s" :initial '{"wifi":false,"ssid":"Wi-Fi","bluetooth":false,"device":"Not connected","brightness":0,"volume":0,"priority":0,"dnd":false}' "~/.config/eww/scripts/control-center.py status")
(defvar cc-glyph true)
(defvar cc-edit false)
(defpoll cc-nightlight :interval "3s" :initial "false" "~/.config/eww/scripts/toggle-nightlight.sh status")
(defpoll cc-brightness :interval "3s" :initial "50" "~/.config/eww/scripts/control-center.py brightness-value")
(defpoll cc-volume :interval "3s" :initial "50" "~/.config/eww/scripts/control-center.py volume-value")
(defwidget cc-quick [icon title enabled command]
  (box :orientation "v" :space-evenly false :spacing 7
    (button :class {enabled ? "cc-round" : "cc-round unavailable"} :active enabled :tooltip {enabled ? title : "${title} hardware unavailable"} :onclick command :halign "center"
      (image :path "${glyph-assets}/cc-${icon}.svg" :image-width 30 :image-height 30))
    (label :class "cc-caption" :text title)))
(defwidget cc-slider [title icon value action]
  (box :orientation "v" :space-evenly false :spacing 6
    (label :class "cc-slider-label" :text title :halign "start")
    (overlay
      (scale :class "cc-slider" :min 0 :max 100 :value value :timeout "2s" :onchange "eww --no-daemonize update cc-${action}={}; ~/.config/eww/scripts/control-center.py ${action} {}")
      (box :class "cc-slider-overlay" :space-evenly false
        (image :path "${glyph-assets}/cc-${icon}-dark.svg" :image-width 24 :image-height 24 :halign "start")
        (label :text "${round(value, 0)}%" :halign "end" :hexpand true)))))
(defwindow control-center
  :namespace "control-center"
  :monitor 0
  :geometry (geometry :x "10px" :y "10px" :width "410px" :height "450px" :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (box :class "control-center-card" :orientation "v" :space-evenly false :spacing 12
    (box :space-evenly false
      (label :class "control-center-title" :markup "<span font_family='Ndot 55'>CONTROL CENTER</span>" :halign "start" :hexpand true)
      (button :class "cc-close" :tooltip "Close (Escape)" :timeout "5s" :onclick "~/.config/eww/scripts/modal.py close" "×"))
    (box :space-evenly true :spacing 10
      (button :class {cc-state.wifi ? "cc-connect" : "cc-connect disabled"} :timeout "5s" :onclick "~/.config/eww/scripts/control-center.py wifi" :tooltip {cc-state.ssid}
        (box :orientation "v" :space-evenly false :spacing 9 :valign "center"
          (image :path "${glyph-assets}/wifi.svg" :image-width 32 :image-height 32)
          (label :text {cc-state.wifi ? cc-state.ssid : "Wi-Fi off"} :limit-width 20)))
      (button :class {cc-state.bluetooth ? "cc-connect" : "cc-connect disabled"} :timeout "5s" :onclick "~/.config/eww/scripts/control-center.py bluetooth" :tooltip {cc-state.device}
        (box :orientation "v" :space-evenly false :spacing 6 :valign "center"
          (image :path "${glyph-assets}/bluetooth.svg" :image-width 30 :image-height 30)
          (label :text {cc-state.bluetooth ? cc-state.device : "Bluetooth off"} :limit-width 20)
          (label :class "cc-secondary" :visible {cc-state.device != "Not connected"} :text "Connected"))))
    (cc-slider :title "Brightness" :icon "sun" :value cc-brightness :action "brightness")
    (cc-slider :title "Volume" :icon "speaker" :value cc-volume :action "volume")
    (button :class "cc-priority" :onclick "~/.config/glyphos/scripts/actions.py notifications" :tooltip "Restore latest notification"
      (box :space-evenly false :spacing 10
        (image :path "${glyph-assets}/cc-bell.svg" :image-width 23 :image-height 23)
        (label :text "${cc-state.priority} Priority Notifications" :halign "start")))
    (box :class "cc-actions" :space-evenly true :spacing 0
      (box :orientation "v" :space-evenly false :spacing 7
        (button :class {cc-nightlight ? "cc-round cc-nightlight active" : "cc-round cc-nightlight"} :timeout "5s" :onclick "~/.config/eww/scripts/toggle-nightlight.sh" :tooltip {cc-nightlight ? "Night Light on · Warm 4000 K" : "Night Light off"} :halign "center"
          (image :path {cc-nightlight ? "${glyph-assets}/cc-nightlight-active.svg" : "${glyph-assets}/cc-nightlight.svg"} :image-width 30 :image-height 30))
        (label :class "cc-caption" :text "Night Light"))
      (cc-quick :icon "capture" :title "Screenshot" :enabled true :command "~/.config/eww/scripts/control-center.py screenshot")
      (cc-quick :icon "mute" :title "Mute" :enabled true :command "~/.config/eww/scripts/control-center.py mute")
      (cc-quick :icon "lock" :title "Lock" :enabled true :command "~/.config/eww/scripts/control-center.py lock")
      (box :orientation "v" :space-evenly false :spacing 7
        (button :class {cc-state.dnd ? "cc-round active" : "cc-round"} :onclick "~/.config/eww/scripts/control-center.py dnd" :tooltip "Do Not Disturb" :halign "center"
          (image :path "${glyph-assets}/cc-dnd.svg" :image-width 30 :image-height 30))
        (label :class "cc-caption" :text "DND")))
    (revealer :reveal cc-edit :transition "slidedown"
      (label :class "cc-edit-note" :wrap true :text "Desktop shortcuts: Night Light, Screenshot, Mute, Lock and DND. Brightness and volume sliders apply immediately."))
    (box :class "cc-footer" :space-evenly false :spacing 12 :halign "end" :vexpand true :valign "end"
      (button :class "cc-footer-button" :tooltip "Settings" :onclick "~/.config/eww/scripts/modal.py close; eww --no-daemonize open settings-window"
        (image :path "${glyph-assets}/settings.svg" :image-width 28 :image-height 28))
      (button :class "cc-footer-button" :tooltip "Edit quick settings" :onclick "eww --no-daemonize update cc-edit=${!cc-edit}"
        (image :path "${glyph-assets}/cc-edit.svg" :image-width 28 :image-height 28)))))

(defwindow glyph-hub
  :namespace "glyphos-glyph-hub"
  :monitor 0
  :geometry (geometry :x "20px" :y "40px" :width "300px" :height "260px" :anchor "top right")
  :stacking "overlay"
  :focusable false
  (box :class "gh-panel" :orientation "v" :space-evenly false :spacing 12
    (label :class "gh-title" :text "GLYPH HUB" :halign "start")
    (box :class "gh-card" :orientation "h" :space-evenly false :spacing 12
      (label :class "gh-icon" :text "M")
      (box :orientation "v" :space-evenly false :spacing 2
        (label :class "gh-app" :text "Gmail" :halign "start")
        (label :class "gh-msg" :text "3 new" :halign "start")))
    (box :class "gh-card" :orientation "h" :space-evenly false :spacing 12
      (label :class "gh-icon" :text "C")
      (box :orientation "v" :space-evenly false :spacing 2
        (label :class "gh-app" :text "Calendar" :halign "start")
        (label :class "gh-msg" :text "Meeting 11AM" :halign "start")))
    (box :class "gh-card" :orientation "h" :space-evenly false :spacing 12
      (label :class "gh-icon" :text "W")
      (box :orientation "v" :space-evenly false :spacing 2
        (label :class "gh-app" :text "WhatsApp" :halign "start")
        (label :class "gh-msg" :text "2 messages" :halign "start")))
    (button :class "gh-close" :onclick "eww --no-daemonize close glyph-hub" "Close")))

(defwidget traffic-lights [window-name]
  (box :class "traffic-lights" :space-evenly false :spacing 8 :valign "center"
    (button :class "traffic-light close" :tooltip "Close" :timeout "5s" :onclick "~/.config/eww/scripts/window-management.py panel close ${window-name}" :valign "center"
        (image :path "/home/nothing_os/.config/eww/assets/control-close.svg" :image-width 24 :image-height 24))
    (button :class "traffic-light minimize" :tooltip "Minimize to taskbar" :timeout "5s" :onclick "~/.config/eww/scripts/window-management.py panel minimize ${window-name}" :valign "center"
        (image :path "/home/nothing_os/.config/eww/assets/control-minimize.svg" :image-width 24 :image-height 24))
    (button :class "traffic-light maximize" :tooltip "Maximize / Restore" :timeout "5s" :onclick "~/.config/eww/scripts/window-management.py panel maximize ${window-name}" :valign "center"
        (image :path "/home/nothing_os/.config/eww/assets/control-maximize.svg" :image-width 24 :image-height 24))))
(defvar active-client '{"address":"","title":"","visible":false}')
(defwindow app-titlebar
  :namespace "glyphos-app-titlebar"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "46px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (box :class "native-titlebar taskbar-center-row" :space-evenly true :spacing 0
    (box :space-evenly false :spacing 8 :halign "start" :valign "center"
    (button :class "bar-utility" :valign "center" :tooltip "Command palette · Ctrl+Shift+P" :timeout "2s" :onclick "python3 /home/nothing_os/.config/eww/scripts/taskbar-action.py palette"
      (image :path "/home/nothing_os/.config/eww/assets/utility-palette.svg" :image-width 22 :image-height 22))
    (button :class "bar-utility" :valign "center" :tooltip "Clipboard history" :timeout "2s" :onclick "python3 /home/nothing_os/.config/eww/scripts/taskbar-action.py clipboard"
      (image :path "/home/nothing_os/.config/eww/assets/utility-clipboard.svg" :image-width 22 :image-height 22))
    (button :class {glyph-focus ? "bar-utility radio-on" : "bar-utility"} :valign "center" :tooltip "Focus mode" :timeout "2s" :onclick "python3 /home/nothing_os/.config/eww/scripts/taskbar-action.py focus"
      (image :path "/home/nothing_os/.config/eww/assets/utility-focus.svg" :image-width 22 :image-height 22))
)
    (box :hexpand true)
    (box :halign "end" :valign "center"
    (box :class "traffic-lights" :visible {active-client.visible} :halign "end" :space-evenly false :spacing 8 :valign "center"
      (button :class "traffic-light close" :tooltip "Close app" :timeout "5s" :onclick "~/.config/eww/scripts/window-management.py close active" :valign "center"
        (image :path "/home/nothing_os/.config/eww/assets/control-close.svg" :image-width 24 :image-height 24))
      (button :class "traffic-light minimize" :tooltip "Minimize app" :timeout "5s" :onclick "~/.config/eww/scripts/window-management.py minimize active" :valign "center"
        (image :path "/home/nothing_os/.config/eww/assets/control-minimize.svg" :image-width 24 :image-height 24))
      (button :class "traffic-light maximize" :tooltip "Maximize / Restore app" :timeout "5s" :onclick "~/.config/eww/scripts/window-management.py maximize active" :valign "center"
        (image :path "/home/nothing_os/.config/eww/assets/control-maximize.svg" :image-width 24 :image-height 24))))))

(defwidget glyphos-settings-panel [window-name]
 (box :class "gs-window" :orientation "v" :space-evenly false
  (box :class "gs-titlebar" :space-evenly false :spacing 14
   (label :text "☰") (label :text "Glyph Control Center" :hexpand true :halign "start")
   (button :class "gs-control" :onclick "~/.config/eww/scripts/window-management.py panel minimize ${window-name}" "−")
   (button :class "gs-control" :onclick "~/.config/eww/scripts/window-management.py panel maximize ${window-name}" "□")
   (button :class "gs-control" :onclick "~/.config/eww/scripts/window-management.py panel close ${window-name}" "×"))
  (box :space-evenly false :vexpand true
   (box :class "gs-sidebar" :width 244 :orientation "v" :space-evenly false
    (label :class "gs-brand" :text "GLYPH CONTROL CENTER" :halign "start")
    (button :class {settings-tab == "System" || (settings-tab == "Display" && "System" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='Display'" (box :space-evenly false :spacing 12 (image :path "assets/settings-monitor.svg" :image-width 18 :image-height 18) (label :text "System" :halign "start")))
(button :class {settings-tab == "Devices" || (settings-tab == "Display" && "Devices" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='Devices'" (box :space-evenly false :spacing 12 (image :path "assets/settings-devices.svg" :image-width 18 :image-height 18) (label :text "Devices" :halign "start")))
(button :class {settings-tab == "Network & Mesh" || (settings-tab == "Display" && "Network & Mesh" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='Network & Mesh'" (box :space-evenly false :spacing 12 (image :path "assets/settings-network.svg" :image-width 18 :image-height 18) (label :text "Network & Mesh" :halign "start")))
(button :class {settings-tab == "Personalization" || (settings-tab == "Display" && "Personalization" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='Personalization'" (box :space-evenly false :spacing 12 (image :path "assets/settings-palette.svg" :image-width 18 :image-height 18) (label :text "Personalization" :halign "start")))
(button :class {settings-tab == "Apps" || (settings-tab == "Display" && "Apps" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='Apps'" (box :space-evenly false :spacing 12 (image :path "assets/settings-apps.svg" :image-width 18 :image-height 18) (label :text "Apps" :halign "start")))
(button :class {settings-tab == "Accounts" || (settings-tab == "Display" && "Accounts" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='Accounts'" (box :space-evenly false :spacing 12 (image :path "assets/settings-account.svg" :image-width 18 :image-height 18) (label :text "Accounts" :halign "start")))
(button :class {settings-tab == "Time & Language" || (settings-tab == "Display" && "Time & Language" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='Time & Language'" (box :space-evenly false :spacing 12 (image :path "assets/settings-language.svg" :image-width 18 :image-height 18) (label :text "Time & Language" :halign "start")))
(button :class {settings-tab == "Gaming" || (settings-tab == "Display" && "Gaming" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='Gaming'" (box :space-evenly false :spacing 12 (image :path "assets/settings-game.svg" :image-width 18 :image-height 18) (label :text "Gaming" :halign "start")))
(button :class {settings-tab == "Accessibility" || (settings-tab == "Display" && "Accessibility" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='Accessibility'" (box :space-evenly false :spacing 12 (image :path "assets/settings-accessibility.svg" :image-width 18 :image-height 18) (label :text "Accessibility" :halign "start")))
(button :class {settings-tab == "Privacy & Security" || (settings-tab == "Display" && "Privacy & Security" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='Privacy & Security'" (box :space-evenly false :spacing 12 (image :path "assets/settings-shield.svg" :image-width 18 :image-height 18) (label :text "Privacy & Security" :halign "start")))
(button :class {settings-tab == "GLYPH Update" || (settings-tab == "Display" && "GLYPH Update" == "System") ? "gs-nav selected" : "gs-nav"} :onclick "eww --no-daemonize update settings-tab='GLYPH Update'" (box :space-evenly false :spacing 12 (image :path "assets/settings-update.svg" :image-width 18 :image-height 18) (label :text "GLYPH Update" :halign "start")))
    (box :vexpand true)
    (box :class "gs-footer" :space-evenly false :spacing 12
     (box :orientation "v" :space-evenly false (label :text "GLYPH OS" :halign "start") (label :class "gs-version" :text "V1.0.0 Alpha" :halign "start"))
     (button :onclick "eww --no-daemonize update settings-tab='GLYPH Update'" :hexpand true :halign "start" "GLYPH Update") (label :text "●" :class "gs-status")))
   (scroll :vscroll true :hscroll false :hexpand true
    (box :class "gs-content" :orientation "v" :space-evenly false :spacing 4
     (label :class "gs-heading" :text {settings-tab == "Display" ? "SYSTEM  ›  DISPLAY" : settings-tab} :halign "start")
     (box :orientation "v" :space-evenly false :spacing 4 :visible {settings-tab == "Display"}
      (box :class "gs-row" :space-evenly false :spacing 10
       (label :text "☼" :class "gs-icon") (label :text "Brightness" :hexpand true :halign "start")
       (scale :class "gs-slider" :width 155 :min 1 :max 100 :value cc-brightness :onchange "~/.config/eww/scripts/control-center.py brightness {}") (label :text "${cc-brightness}%" :width 38))
      (box :class "gs-row" :space-evenly false :spacing 10 (label :text "◉") (label :text "Color profile" :hexpand true :halign "start") (label :class "gs-value" :text "sRGB (Default)" :tooltip "Default color space; ICC profile configuration is not installed."))
      (label :class "gs-section" :text "SCALE & LAYOUT" :halign "start")
      (box :class "gs-row" :space-evenly false
       (box :orientation "v" :space-evenly false :hexpand true (label :text "Scale" :halign "start") (label :class "gs-sub" :text "Select display using your current settings" :halign "start"))
       (overlay :width 152
        (combo-box-text :class "gs-value" :items {settings-display.scales} :onchange "~/.config/eww/scripts/settings-display.py scale '{}'" :timeout "5s")
        (label :class "gs-choice-label" :text {settings-display.scale} :halign "start")))
      (box :class "gs-row" :space-evenly false
       (box :orientation "v" :space-evenly false :hexpand true (label :text "Display resolution" :halign "start") (label :class "gs-sub" :text "Select a display mode supported by this monitor" :halign "start"))
       (overlay :width 152
        (combo-box-text :class "gs-value" :items {settings-display.modes} :onchange "~/.config/eww/scripts/settings-display.py mode '{}'" :timeout "5s")
        (label :class "gs-choice-label" :text {settings-display.mode} :halign "start")))
      (box :class "gs-multiple" :orientation "v" :space-evenly false
       (box :class "gs-row" :space-evenly false (label :text "Multiple displays" :hexpand true :halign "start") (label :text "⌃"))
       (label :class "gs-display-info" :text {settings-display.summary} :halign "start"))
      (label :class "gs-help" :text "Use the controls above to configure your current display." :halign "start")
      (button :class "gs-link" :onclick "~/.config/eww/scripts/settings-display.py advanced" :halign "start" "Advanced display settings")
      (button :class "gs-link" :onclick "~/.config/eww/scripts/settings-display.py graphics" :halign "start" "Graphics settings"))
     (box :orientation "v" :space-evenly false :spacing 12 :visible {settings-tab != "Display"}
      (label :class "gs-description" :text {settings-tab == "GLYPH Update" ? "GLYPH OS · Version 1.0.0 Alpha
Review available system updates before installing." : "Manage your ${settings-tab} settings."} :halign "start" :wrap true)
      (button :class "gs-row" :onclick "~/.config/eww/scripts/settings-display.py section '${settings-tab}'" :halign "start" (label :text {settings-tab == "GLYPH Update" ? "Check for updates" : "Open ${settings-tab} controls"}))) )))))

(defwindow settings-window
  :namespace "glyphos-settings"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "720px" :height "488px" :anchor "center")
  :stacking "overlay"
  :focusable false
  (glyphos-settings-panel :window-name "settings-window"))

(defwindow settings-app
  :namespace "glyphos-settings-app"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "720px" :height "488px" :anchor "center")
  :stacking "overlay"
  :focusable false
  (glyphos-settings-panel :window-name "settings-app"))

(defwindow settings-app-max
  :namespace "glyphos-settings-app-max"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :y "-72px" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :focusable false
  (glyphos-settings-panel :window-name "settings-app-max"))

(defwindow nowplaying
  :namespace "glyphos-nowplaying"
  :monitor 0
  :geometry (geometry :x "0px" :y "105px" :width "380px" :height "180px" :anchor "bottom center")
  :stacking "bottom"
  :focusable false
  (overlay :class "nowplaying-art" :height 180 :width 380
    (box :height 180 :width 380)
    (revealer :transition "crossfade" :duration "600ms" :reveal {island-art.pane == 0}
      (box :class "nowplaying-art-layer" :height 180 :width 380 :style {island-art.a}))
    (revealer :transition "crossfade" :duration "600ms" :reveal {island-art.pane == 1}
      (box :class "nowplaying-art-layer" :height 180 :width 380 :style {island-art.b}))
  (box :class "music-card dock-media" :orientation "v" :space-evenly false :spacing 6
    (label :class "music-heading" :text "Now Playing" :halign "start")
    (label :class "music-text" :text {island-state.title} :halign "start" :limit-width 38)
    (label :class "music-artist" :text {island-state.artist} :halign "start" :limit-width 46)
    (scale :class "music-progress" :min 0 :max 100 :value {island-state.progress} :onchange "~/.config/eww/scripts/media.py seek {}")
    (box :class "music-controls" :space-evenly false :spacing 18 :halign "center"
      (button :class "transport" :onclick "playerctl previous" :tooltip "Previous track"
        (image :path "${glyph-assets}/previous.svg" :image-width 24 :image-height 24))
      (button :class "transport-main" :onclick "playerctl play-pause" :tooltip "Play / pause"
        (image :path {island-state.status == "Playing" ? "${glyph-assets}/pause.svg" : "${glyph-assets}/play.svg"} :image-width 24 :image-height 24))
      (button :class "transport" :onclick "playerctl next" :tooltip "Next track"
        (image :path "${glyph-assets}/next.svg" :image-width 24 :image-height 24))))))

(defvar launcher-query "")
(defpoll launcher-weather :interval "60s" :initial '{"temperature":"—","location":"Chandigarh","status":"Local weather"}'
  "~/.config/eww/scripts/launcher-weather.py")

(defwindow app-launcher
  :namespace "glyphos-app-launcher"
  :monitor 0
  :geometry (geometry :x "40px" :y "40px" :width "620px" :height "530px" :anchor "bottom left")
  :stacking "overlay"
  :focusable true
  (box :class "launcher-window" :orientation "v" :space-evenly false :spacing 16
    (box :class "launcher-search" :orientation "h" :space-evenly false :spacing 12
      (label :class "launcher-search-icon" :text "⌕")
      (overlay :hexpand true
        (input :class "launcher-input" :value "" :hexpand true :timeout "2s"
          :onchange "~/.config/eww/scripts/launcher-search.py '{}'"
          :onaccept "eww --no-daemonize close app-launcher; ~/.config/glyphos/scripts/search.py launch '{}'")
        (label :class "launcher-placeholder" :markup "<span font_family='Ndot 55'>Search apps, files, or settings...</span>"
          :visible {launcher-query == ""} :halign "start" :valign "center")))
    (box :class "launcher-header" :orientation "h" :space-evenly false :spacing 10
      (box :hexpand true :halign "start" (glyphos-brand))
      (button :class "launcher-close" :onclick "eww --no-daemonize close app-launcher" "×"))
    (box :class "launcher-body" :orientation "h" :space-evenly false :spacing 18
      (box :class "launcher-sidebar" :orientation "v" :space-evenly false :spacing 6
        (button :class "sidebar-item" :onclick "~/.config/eww/scripts/modal.py power" (label :markup "<span font_family='Ndot 55'>⏻  Power</span>"))
        (box :orientation "h" :space-evenly false :spacing 6
          (button :class "sidebar-item" :onclick "eww --no-daemonize open settings-window; eww --no-daemonize close app-launcher" :hexpand true (label :markup "<span font_family='Ndot 55'>⚙  Settings</span>"))
          (button :class "launcher-more" :onclick {more-open ? "eww --no-daemonize update more-open=false" : "eww --no-daemonize update more-open=true"}
            {more-open ? "▾" : "▸"}))
        (revealer :reveal more-open :transition "slidedown"
          (box :orientation "v" :space-evenly false :spacing 6
            (button :class "sidebar-item" :onclick "eww --no-daemonize open device-manager; eww --no-daemonize close app-launcher" (label :markup "<span font_family='Ndot 55'>Devices</span>"))
            (button :class "sidebar-item" :onclick "eww --no-daemonize open power-display; eww --no-daemonize close app-launcher" (label :markup "<span font_family='Ndot 55'>Display &amp; Power</span>"))))
        (button :class "sidebar-item" :onclick "eww --no-daemonize open task-manager; eww --no-daemonize close app-launcher" (label :markup "<span font_family='Ndot 55'>Task Manager</span>"))
        (button :class "sidebar-item" :onclick "eww --no-daemonize open doc-reader; eww --no-daemonize close app-launcher" (label :markup "<span font_family='Ndot 55'>Documents</span>"))
        (button :class "sidebar-item" :onclick "eww --no-daemonize open screen-tools; eww --no-daemonize close app-launcher" (label :markup "<span font_family='Ndot 55'>Screenshot</span>"))
        (button :class "sidebar-item" :onclick "eww --no-daemonize open calendar-tasks; eww --no-daemonize close app-launcher" (label :markup "<span font_family='Ndot 55'>Calendar</span>"))
        (button :class "sidebar-item" :onclick "xdg-open https://mail.google.com & eww --no-daemonize close app-launcher" (label :markup "<span font_family='Ndot 55'>Gmail</span>"))
        (button :class "sidebar-item" :onclick "spotify & eww --no-daemonize close app-launcher" (label :markup "<span font_family='Ndot 55'>Music Player</span>"))
        (button :class "sidebar-allapps" :onclick "eww --no-daemonize close app-launcher" (label :markup "<span font_family='Ndot 55'>All Apps</span>")))
      (box :class "launcher-grid" :orientation "v" :space-evenly false :spacing 12 :hexpand true :valign "start"
        (label :class "launcher-section-title" :markup "<span font_family='Ndot 55'>PINNED</span>" :halign "start")
        (box :orientation "h" :space-evenly true :spacing 12
          (box :class "tile launcher-weather-card" :orientation "v" :space-evenly false :spacing 8
            (label :class "tile-value" :markup "<span font_family='Ndot 55'>${launcher-weather.temperature}</span>" :halign "start")
            (label :class "tile-label" :text {launcher-weather.location} :halign "start")
            (label :class "launcher-weather-status" :text {launcher-weather.status} :halign "start"))
          (button :class "tile" :onclick "dolphin ~/Documents & eww --no-daemonize close app-launcher"
            (box :orientation "v" :space-evenly false :spacing 12
              (image :path "/usr/share/icons/Papirus-Light/64x64/apps/system-file-manager.svg" :image-width 36 :image-height 36)
              (label :class "tile-label" :markup "<span font_family='Ndot 55'>Documents</span>"))))
        (box :orientation "h" :space-evenly true :spacing 12
          (button :class "tile" :onclick "dolphin & eww --no-daemonize close app-launcher"
            (box :orientation "v" :space-evenly false :spacing 12
              (image :path "/usr/share/icons/Papirus-Light/64x64/apps/system-file-manager.svg" :image-width 36 :image-height 36)
              (label :class "tile-label" :markup "<span font_family='Ndot 55'>Files</span>")))
          (button :class "tile" :onclick "brave & eww --no-daemonize close app-launcher"
            (box :orientation "v" :space-evenly false :spacing 12
              (image :path "/usr/share/icons/Papirus/64x64/apps/brave-browser.svg" :image-width 36 :image-height 36)
              (label :class "tile-label" :markup "<span font_family='Ndot 55'>Internet</span>"))))
        (label :class "launcher-search-result" :text search-preview :visible {launcher-query != ""} :halign "start" :wrap true :limit-width 42)))))

(defwindow power-menu
  :namespace "glyphos-power-menu"
  :monitor 0
  :geometry (geometry :x "500px" :y "100px" :width "200px" :height "160px" :anchor "bottom left")
  :stacking "overlay"
  :focusable false
  (box :class "launcher-sidebar" :orientation "v" :space-evenly false :spacing 4
    (button :class "sidebar-item" :timeout "5s" :onclick "~/.config/eww/scripts/modal.py shutdown" "⏻  Shut Down")
    (button :class "sidebar-item" :timeout "5s" :onclick "~/.config/eww/scripts/modal.py reboot" "⟳  Restart")
    (button :class "sidebar-item" :timeout "5s" :onclick "~/.config/eww/scripts/modal.py logout" "↪  Log Out")
    (button :class "sidebar-item" :timeout "5s" :onclick "~/.config/eww/scripts/modal.py close" "✕  Cancel")))

(defpoll cpu-usage :interval "2s" "top -bn1 | grep 'Cpu(s)' | awk '{print 100-$8}' | cut -d'.' -f1 || echo 0")
(defpoll mem-usage :interval "2s" "free | awk '/Mem:/ {printf \"%.0f\", $3/$2*100}'")
(defpoll storage-usage :interval "10s" "df -h / | tail -1 | awk '{print $5}' | tr -d '%'")
(defpoll storage-used :interval "10s" "df -h / | tail -1 | awk '{print $3}'")
(defpoll net-down :interval "2s" "a=$(grep -v lo: /proc/net/dev | awk '{s+=$2} END{print s}'); sleep 1; b=$(grep -v lo: /proc/net/dev | awk '{s+=$2} END{print s}'); echo $(( (b-a)/1024 ))")
(defpoll net-up :interval "2s" "a=$(grep -v lo: /proc/net/dev | awk '{s+=$10} END{print s}'); sleep 1; b=$(grep -v lo: /proc/net/dev | awk '{s+=$10} END{print s}'); echo $(( (b-a)/1024 ))")

(defwindow sys-resources
  :namespace "glyphos-sys-resources"
  :monitor 0
  :geometry (geometry :x "40px" :y "500px" :width "400px" :height "260px" :anchor "top right")
  :stacking "bottom"
  (box :class "np-widget" :orientation "v" :space-evenly false :spacing 10
    (label :class "np-heading" :text "SYSTEM RESOURCES" :halign "start")
    (box :orientation "h" :space-evenly true :spacing 10
      (box :orientation "v" :spacing 2
        (label :class "sys-label" :text "CPU ${cpu-usage}%" :halign "start")
        (graph :thickness 2 :time-range "60s" :min 0 :max 100 :value {cpu-usage == "" ? 0 : cpu-usage} :line-style "round" :width 110 :height 40))
      (box :orientation "v" :spacing 2
        (label :class "sys-label" :text "Memory ${mem-usage}%" :halign "start")
        (progress :value {mem-usage == "" ? 0 : mem-usage} :width 110 :height 8)))
    (box :orientation "v" :spacing 2
      (label :class "sys-label" :text "Storage ${storage-usage}%" :halign "start")
      (progress :value {storage-usage == "" ? 0 : storage-usage} :width 340 :height 8))
    (label :class "np-heading" :text "NETWORK ACTIVITY" :halign "start")
    (box :orientation "h" :space-evenly true :spacing 10
      (box :orientation "v" :spacing 2
        (label :class "sys-label" :text "↓ ${net-down} KB/s" :halign "start")
        (graph :thickness 2 :time-range "60s" :min 0 :max 500 :value {net-down == "" ? 0 : net-down} :line-style "round" :width 340 :height 40)))))

(defpoll wifi-list :interval "5s" "nmcli -t -f SSID,SIGNAL dev wifi list 2>/dev/null | head -6 | awk -F: '{print $1\" (\"$2\"%)\"}'")
(defpoll bt-list :interval "5s" "bluetoothctl devices 2>/dev/null | cut -d' ' -f3- | head -6")

(defwindow wifi-menu
  :namespace "glyphos-wifi" :monitor 0
  :geometry (geometry :x "70px" :y "8px" :width "340px" :height "330px" :anchor "top right")
  :stacking "overlay" :exclusive false :focusable false
  (box :class "cc-panel" :orientation "v" :space-evenly false :spacing 10
    (box :space-evenly false
      (label :class "cc-title" :text "WI-FI" :hexpand true :halign "start")
      (button :class {bar-connectivity.wifi ? "glyph-action radio-on" : "glyph-action"} :onclick "~/.config/glyphos/scripts/actions.py wifi-toggle" :tooltip "Toggle Wi-Fi" {bar-connectivity.wifi ? "ON" : "OFF"}))
    (scroll :vscroll true :hscroll false :vexpand true
      (box :orientation "v" :space-evenly false :spacing 6
        (for network in glyph-wifi-rows
          (button :class "app-menu-item" :onclick "~/.config/glyphos/scripts/actions.py wifi-connect ${network.id}" (label :text {network.label} :limit-width 34 :halign "start")))))
    (button :class "cc-tile" :onclick "eww --no-daemonize close wifi-menu" "Close")))
(defwindow bluetooth-menu
  :namespace "glyphos-bluetooth" :monitor 0
  :geometry (geometry :x "110px" :y "8px" :width "340px" :height "330px" :anchor "top right")
  :stacking "overlay" :exclusive false :focusable false
  (box :class "cc-panel" :orientation "v" :space-evenly false :spacing 10
    (box :space-evenly false
      (label :class "cc-title" :text "BLUETOOTH" :hexpand true :halign "start")
      (button :class {bar-connectivity.bluetooth ? "glyph-action radio-on" : "glyph-action"} :onclick "~/.config/glyphos/scripts/actions.py bluetooth-toggle" {bar-connectivity.bluetooth ? "ON" : "OFF"}))
    (button :class "app-menu-item" :onclick "~/.config/glyphos/scripts/actions.py bluetooth-scan" "Scan for 8 seconds")
    (scroll :vscroll true :hscroll false :vexpand true
      (box :orientation "v" :space-evenly false :spacing 6
        (for device in glyph-bt-rows
          (button :class "app-menu-item" :onclick "~/.config/glyphos/scripts/actions.py bluetooth-connect ${device.id}" (label :text {device.label} :limit-width 32 :halign "start")))))
    (button :class "cc-tile" :onclick "eww --no-daemonize close bluetooth-menu" "Close")))

(defwindow weather
  :namespace "glyphos-weather"
  :monitor 0
  :geometry (geometry :x "4%" :y "11%" :width "570px" :height "164px" :anchor "top left")
  :stacking "bottom"
  :focusable false
  (box :class "desktop-heading" :orientation "v" :space-evenly false :spacing 0
    (box :space-evenly false :spacing 30
      (label :class "ndot-heading" :markup "<span font_family='Ndot 55'>GLYPH</span>")
      (label :class "ndot-heading" :markup "<span font_family='Ndot 55'>${launcher-weather.temperature}</span>"))
    (box :space-evenly false :spacing 30
      (label :class "ndot-heading" :markup "<span font_family='Ndot 55'>CLOCK</span>")
      (image :path "${glyph-assets}/cloud-dark.svg" :image-width 108 :image-height 62)
      (label :class "desktop-city" :text {launcher-weather.location} :valign "start"))))

(defpoll usb-devices :interval "5s" "lsusb | grep -v 'Linux Foundation' | cut -d' ' -f7- | head -6")
(defpoll audio-sinks :interval "5s" "pactl list short sinks | awk '{print $2}' | head -4")
(defpoll audio-current :interval "3s" "pactl get-default-sink 2>/dev/null")

(defvar search-preview "")
(defvar more-open false)
(defvar cc-wifi-open false)
(defvar cc-bt-open false)
(defvar cc-batt-open false)
(defvar dm-audio-open false)
(defvar dm-bt-open false)
(defvar dm-usb-open false)
(defvar dm-net-open false)

(defwindow device-manager
  :namespace "glyphos-device-manager"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "700px" :height "600px" :anchor "center")
  :stacking "overlay"
  :focusable false
  (box :class "settings-window" :orientation "v" :space-evenly false :spacing 0
    (box :class "settings-titlebar" :space-evenly false :spacing 14
      (label :class "titlebar-text" :text "Device Manager" :halign "start" :hexpand true)
      (traffic-lights :window-name "device-manager"))
    (box :class "dm-panel-dark" :orientation "v" :space-evenly false :spacing 4 :vexpand true
      (label :class "cc-title" :text "💻 NOTHING-ARCH" :halign "start")
      (eventbox :onclick {dm-audio-open ? "eww --no-daemonize update dm-audio-open=false" : "eww --no-daemonize update dm-audio-open=true"}
        (box :class "dm-category" :orientation "h" :space-evenly false :spacing 8
          (label :text {dm-audio-open ? "▾" : "▸"})
          (label :class "cc-title" :text "🔊  Audio devices" :halign "start" :hexpand true)))
      (revealer :reveal dm-audio-open :transition "slidedown"
        (box :class "dm-content" :orientation "v" :spacing 4
          (label :class "cc-label" :text "Current: ${audio-current}" :halign "start")
          (label :class "cc-label" :text audio-sinks :halign "start" :wrap true)))

      (eventbox :onclick {dm-bt-open ? "eww --no-daemonize update dm-bt-open=false" : "eww --no-daemonize update dm-bt-open=true"}
        (box :class "dm-category" :orientation "h" :space-evenly false :spacing 8
          (label :text {dm-bt-open ? "▾" : "▸"})
          (label :class "cc-title" :text "🅱  Bluetooth" :halign "start" :hexpand true)))
      (revealer :reveal dm-bt-open :transition "slidedown"
        (box :class "dm-content" :orientation "v" :spacing 4
          (label :class "cc-label" :text bt-list :halign "start" :wrap true)
          (button :class "cc-tile" :onclick "eww --no-daemonize open --toggle bluetooth-menu &" "Manage Bluetooth")))

      (eventbox :onclick {dm-usb-open ? "eww --no-daemonize update dm-usb-open=false" : "eww --no-daemonize update dm-usb-open=true"}
        (box :class "dm-category" :orientation "h" :space-evenly false :spacing 8
          (label :text {dm-usb-open ? "▾" : "▸"})
          (label :class "cc-title" :text "🔌  USB & HID devices" :halign "start" :hexpand true)))
      (revealer :reveal dm-usb-open :transition "slidedown"
        (box :class "dm-content" :orientation "v" :spacing 4
          (label :class "cc-label" :text usb-devices :halign "start" :wrap true)))

      (eventbox :onclick {dm-net-open ? "eww --no-daemonize update dm-net-open=false" : "eww --no-daemonize update dm-net-open=true"}
        (box :class "dm-category" :orientation "h" :space-evenly false :spacing 8
          (label :text {dm-net-open ? "▾" : "▸"})
          (label :class "cc-title" :text "📶  Network adapters" :halign "start" :hexpand true)))
      (revealer :reveal dm-net-open :transition "slidedown"
        (box :class "dm-content" :orientation "v" :spacing 4
          (label :class "cc-label" :text "Honda_5G - Connected" :halign "start"))))))

(defwindow device-manager-max
  :namespace "glyphos-device-manager-max"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :y "-72px" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :focusable false
  (box :class "settings-window" :orientation "v" :space-evenly false :spacing 0 :vexpand true :hexpand true
    (box :class "settings-titlebar" :space-evenly false :spacing 14
      (label :class "titlebar-text" :text "Device Manager" :halign "start" :hexpand true)
      (traffic-lights :window-name "device-manager-max"))
    (box :class "dm-panel-dark" :orientation "v" :space-evenly false :spacing 4 :vexpand true :hexpand true
      (label :class "cc-title" :text "🔊  Audio devices" :halign "start")
      (label :class "cc-label" :text audio-sinks :halign "start" :wrap true)
      (label :class "cc-title" :text "🅱  Bluetooth" :halign "start")
      (label :class "cc-label" :text bt-list :halign "start" :wrap true)
      (label :class "cc-title" :text "🔌  USB & HID devices" :halign "start")
      (label :class "cc-label" :text usb-devices :halign "start" :wrap true))))

(defpoll top-processes :interval "3s" "ps -eo comm,%cpu --sort=-%cpu | head -6 | tail -5")

(defwindow task-manager
  :namespace "glyphos-task-manager"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "420px" :height "360px" :anchor "center")
  :stacking "overlay"
  :focusable false
  (box :class "settings-window" :orientation "v" :space-evenly false :spacing 0
    (box :class "settings-titlebar" :space-evenly false :spacing 14
      (label :class "titlebar-text" :text "Task Manager" :halign "start" :hexpand true)
      (traffic-lights :window-name "task-manager"))
    (box :class "cc-panel" :orientation "v" :space-evenly false :spacing 14
      (label :class "cc-title" :text "TOP PROCESSES (CPU%)" :halign "start")
      (label :class "cc-label" :text top-processes :halign "start" :wrap true)
      (button :class "cc-tile" :onclick "kitty -e htop &" "Open Full Task Manager"))))

(defpoll recent-docs :interval "10s" "find ~/Documents ~/Downloads -maxdepth 1 -type f \\( -iname '*.pdf' -o -iname '*.docx' -o -iname '*.txt' \\) 2>/dev/null | xargs -r -d '\\n' -n1 basename 2>/dev/null | head -8")
(defpoll calendar-view :interval "60s" "cal")
(defpoll today-date :interval "60s" "date '+%A, %d %B %Y'")
(defpoll tasks-list :interval "3s" "cat ~/.local/share/nothingos/tasks.txt 2>/dev/null || true")
(defpoll recording-status :interval "2s" "pgrep wf-recorder > /dev/null && echo 'Recording...' || echo 'Not recording'")
(defpoll power-profile :interval "5s" "powerprofilesctl get 2>/dev/null || echo 'balanced'")

(defwindow doc-reader
  :namespace "glyphos-doc-reader"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "420px" :height "440px" :anchor "center")
  :stacking "overlay"
  :focusable false
  (box :class "settings-window" :orientation "v" :space-evenly false :spacing 0
    (box :class "settings-titlebar" :space-evenly false :spacing 14
      (label :class "titlebar-text" :text "Documents" :halign "start" :hexpand true)
      (traffic-lights :window-name "doc-reader"))
    (box :class "cc-panel" :orientation "v" :space-evenly false :spacing 10
      (label :class "cc-title" :text "RECENT DOCUMENTS" :halign "start")
      (label :class "cc-label" :text recent-docs :halign "start" :wrap true)
      (button :class "cc-tile" :onclick "dolphin ~/Documents &" "Browse All Documents"))))

(defwindow screen-tools
  :namespace "glyphos-screen-tools"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "320px" :height "260px" :anchor "center")
  :stacking "overlay"
  :focusable false
  (box :class "settings-window" :orientation "v" :space-evenly false :spacing 0
    (box :class "settings-titlebar" :space-evenly false :spacing 14
      (label :class "titlebar-text" :text "Screenshot & Recorder" :halign "start" :hexpand true)
      (traffic-lights :window-name "screen-tools"))
    (box :class "cc-panel" :orientation "v" :space-evenly false :spacing 12
      (button :class "cc-tile" :onclick "grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png" "📸 Full Screenshot")
      (button :class "cc-tile" :onclick "grim -g \"$(slurp)\" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png" "✂ Select Area")
      (label :class "cc-label" :text recording-status :halign "start")
      (button :class "cc-tile" :onclick "wf-recorder -f ~/Videos/recording-$(date +%Y%m%d-%H%M%S).mp4 &" "⏺ Start Recording")
      (button :class "cc-tile" :onclick "pkill wf-recorder" "⏹ Stop Recording"))))

(defwindow calendar-tasks
  :namespace "glyphos-calendar-tasks"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "420px" :height "480px" :anchor "center")
  :stacking "overlay"
  :focusable false
  (box :class "settings-window" :orientation "v" :space-evenly false :spacing 0
    (box :class "settings-titlebar" :space-evenly false :spacing 14
      (label :class "titlebar-text" :text "Calendar & Tasks" :halign "start" :hexpand true)
      (traffic-lights :window-name "calendar-tasks"))
    (box :class "cc-panel" :orientation "v" :space-evenly false :spacing 10
      (label :class "cc-title" :text today-date :halign "start")
      (label :class "cc-label" :text calendar-view :halign "start")
      (label :class "cc-title" :text "TASKS" :halign "start")
      (label :class "cc-label" :text tasks-list :halign "start" :wrap true)
      (input :class "search-placeholder" :value "" :hexpand true :onaccept "echo {} >> ~/.local/share/nothingos/tasks.txt"))))

(defwindow power-display
  :namespace "glyphos-power-display"
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "320px" :height "300px" :anchor "center")
  :stacking "overlay"
  :focusable false
  (box :class "settings-window" :orientation "v" :space-evenly false :spacing 0
    (box :class "settings-titlebar" :space-evenly false :spacing 14
      (label :class "titlebar-text" :text "Display & Power" :halign "start" :hexpand true)
      (traffic-lights :window-name "power-display"))
    (box :class "cc-panel" :orientation "v" :space-evenly false :spacing 12
      (label :class "cc-label" :text "Brightness" :halign "start")
      (scale :min 0 :max 100 :value 70 :onchange "brightnessctl set {}\%")
      (label :class "cc-label" :text "Power Profile: ${power-profile}" :halign "start")
      (box :orientation "h" :space-evenly true :spacing 8
        (button :class "cc-tile" :onclick "powerprofilesctl set power-saver 2>/dev/null" "Saver")
        (button :class "cc-tile" :onclick "powerprofilesctl set balanced 2>/dev/null" "Balanced")
        (button :class "cc-tile" :onclick "powerprofilesctl set performance 2>/dev/null" "Performance"))
      (button :class "cc-tile" :onclick "systemctl suspend" "💤 Sleep"))))

;; A non-focusable foreground surface catches only clicks outside overlay panels.
;; modal.py removes it and the temporary Escape binding as soon as the panel closes.
(defvar modal-active false)
(defwindow modal-dismiss
  :namespace "modal-dismiss"
  :monitor 0
  :geometry (geometry :y "-72px" :width "100%" :height "100%" :anchor "top left")
  :stacking "fg"
  :exclusive false
  :focusable false
  (button :class "modal-dismiss" :timeout "5s" :onclick "~/.config/eww/scripts/modal.py close" :hexpand true :vexpand true ""))

;; User-only Flatpak app management; every destructive action requires confirmation.
(defvar app-context '{"key":"unsupported","name":"Application","flatpak":"","pinned":false,"supported":false,"can_uninstall":false,"error":""}')
(defpoll app-operation :interval "1s" :initial '{"state":"","detail":""}' "~/.config/eww/scripts/app-service.py status")
(defwindow taskbar-context [context-monitor context-x context-y]
  :namespace "glyphos-taskbar-context"
  :monitor context-monitor
  :geometry (geometry :x "${context-x}px" :y "${context-y}px" :width "280px" :height "330px" :anchor "top left")
  :stacking "fg"
  :exclusive false
  :focusable false
  (box :class "app-context-menu" :orientation "v" :space-evenly false :spacing 7
    (label :class "app-menu-title" :text {app-context.name} :halign "start")
    (button :class "app-menu-item" :onclick "~/.config/glyphos/scripts/actions.py context-close" "Close Window")
    (button :class "app-menu-item" :onclick "~/.config/glyphos/scripts/actions.py context-details" "App Details")
    (button :class "app-menu-item" :visible {!app-context.pinned} :active {app-context.supported}
      :onclick "~/.config/eww/scripts/app-service.py pin ${app-context.key}" "Pin to Taskbar")
    (button :class "app-menu-item" :visible {app-context.pinned}
      :onclick "~/.config/eww/scripts/app-service.py unpin ${app-context.key}" "Unpin from Taskbar")
    (button :class "app-menu-item destructive" :active {app-context.can_uninstall}
      :tooltip {app-context.can_uninstall ? "Remove this user Flatpak application" : "Only user-installed Flatpak apps can be removed here"}
      :onclick "~/.config/eww/scripts/app-service.py confirm ${app-context.key}" "Uninstall App")
    (label :visible {!app-context.supported} :class "app-menu-note" :text "No desktop launcher found for this item." :wrap true)
    (label :class "app-menu-note" :visible {app-context.error != ""} :text {app-context.error} :wrap true)))
(defwindow app-uninstall-confirm
  :namespace "glyphos-app-uninstall"
  :monitor 0
  :geometry (geometry :width "460px" :height "220px" :anchor "center")
  :stacking "overlay"
  :focusable true
  (box :class "app-confirm" :orientation "v" :space-evenly false :spacing 20
    (label :class "app-menu-title" :text "Uninstall application?" :halign "start")
    (label :text "Are you sure you want to uninstall ${app-context.name}? This will remove all local application data." :wrap true :limit-width 48 :halign "start")
    (label :class "app-menu-note" :text {app-context.error} :visible {app-context.error != ""} :wrap true)
    (box :space-evenly true :spacing 12
      (button :class "app-menu-item" :onclick "eww --no-daemonize close app-uninstall-confirm" "Cancel")
      (button :class "app-menu-item destructive" :onclick "~/.config/eww/scripts/app-service.py uninstall ${app-context.key}" "Uninstall"))))
(defwindow app-operation-status
  :namespace "glyphos-app-operation"
  :monitor 0
  :geometry (geometry :width "460px" :height "170px" :anchor "center")
  :stacking "overlay"
  :focusable true
  (box :class "app-confirm" :orientation "v" :space-evenly false :spacing 16
    (label :class "app-menu-title" :text {app-operation.state == "working" ? "Uninstalling…" : app-operation.state == "error" ? "Unable to uninstall" : app-operation.state == "done" ? "App uninstalled" : "Preparing…"})
    (label :text {app-operation.detail} :wrap true :limit-width 50)
    (button :class "app-menu-item" :onclick "eww --no-daemonize close app-operation-status" "Dismiss")))

(defwindow glyph-notifications
  :namespace "glyphos-notifications" :monitor 0
  :geometry (geometry :x "12px" :y "8px" :width "390px" :height "420px" :anchor "top right")
  :stacking "overlay" :exclusive false :focusable false
  (box :class "cc-panel" :orientation "v" :space-evenly false :spacing 10
    (label :class "cc-title" :text "NOTIFICATIONS" :halign "start")
    (scroll :vscroll true :hscroll false :vexpand true
      (box :orientation "v" :space-evenly false :spacing 12
        (for group in glyph-notifications
          (box :class "notification-stack" :orientation "v" :space-evenly false :spacing 8
            (label :text "${group.app} · ${group.count}" :halign "start")
            (label :text {group.summary != "" ? group.summary : group.text} :wrap true :limit-width 42 :halign "start")
            (button :class "app-menu-item" :tooltip "Send this stack to Gemini for a one-line summary" :onclick "~/.config/glyphos/scripts/actions.py summarize ${group.id}" "Summarise with AI")))))
    (button :class "app-menu-item" :onclick "eww --no-daemonize close glyph-notifications" "Close")))
(defwindow glyph-app-details
  :namespace "glyphos-app-details" :monitor 0
  :geometry (geometry :width "420px" :height "220px" :anchor "center")
  :stacking "overlay" :exclusive false :focusable false
  (box :class "cc-panel" :orientation "v" :space-evenly false :spacing 12
    (label :class "cc-title" :text "APP DETAILS")
    (label :text glyph-detail :wrap true)
    (button :class "app-menu-item" :onclick "eww --no-daemonize close glyph-app-details" "Close")))

;; Per-entry actions use opaque IDs; clipboard text never enters a shell command.
(deflisten clipboard-rows :initial "[]"
  "python3 -u /home/nothing_os/.config/eww/scripts/clipboard-history.py stream")
(defwindow clipboard-history
  :namespace "glyphos-clipboard-history" :monitor 0
  :geometry (geometry :x "12px" :y "8px" :width "460px" :height "520px" :anchor "top left")
  :stacking "overlay" :exclusive false :focusable false
  (box :class "clipboard-panel" :orientation "v" :space-evenly false :spacing 12
    (box :space-evenly false :spacing 12
      (label :class "clipboard-title" :text "Clipboard History" :hexpand true :halign "start")
      (button :class "clipboard-close" :timeout "2s" :onclick "eww --no-daemonize close clipboard-history" "×"))
    (label :class "clipboard-empty" :visible {arraylength(clipboard-rows) == 0} :text "Your copied text will appear here." :halign "start")
    (scroll :vscroll true :hscroll false :vexpand true
      (box :orientation "v" :space-evenly false :spacing 10
        (for entry in clipboard-rows
          (box :class "clipboard-entry" :orientation "v" :space-evenly false :spacing 8
            (label :class "clipboard-pin" :visible {entry.pinned} :text "PINNED" :halign "start")
            (label :class "clipboard-preview" :text {entry.text} :wrap true :limit-width 46 :halign "start" :xalign 0)
            (box :space-evenly false :spacing 8
              (button :class "clipboard-copy" :timeout "2s" :onclick "python3 /home/nothing_os/.config/eww/scripts/taskbar-action.py clipboard-copy ${entry.key}" "Copy")
              (button :class "clipboard-delete" :timeout "2s" :tooltip {entry.pinned ? "Remove this pinned entry" : "Delete this entry from history"} :onclick "python3 /home/nothing_os/.config/eww/scripts/taskbar-action.py clipboard-delete ${entry.key}" "Delete"))))))))

(include "volume_osd/volume_osd.yuck")

(include "snap_layout/snap_layout.yuck")

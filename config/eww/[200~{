{
    "layer": "top",
    "position": "top",
    "height": 24,
    "margin-top": 4,
    "modules-left": ["clock"],
    "modules-right": ["network", "bluetooth", "battery"],

    "clock": {
        "format": "{:%I:%M %p  %a %d %b}",
        "tooltip": false
    },
    "network": {
        "format-wifi": " {essid}",
        "format-disconnected": " Offline",
        "tooltip": false
    },
    "bluetooth": {
        "format": " On",
        "format-disabled": "",
        "tooltip": false
    },
    "battery": {
        "format": " {capacity}%",
        "tooltip": false
    }
}
